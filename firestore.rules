rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles strictly isolated to authenticated owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Journal entries and chat reflections strictly isolated to authenticated owner
      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
